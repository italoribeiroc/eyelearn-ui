# Server-only: base URL of the Django backend. Never prefix with NEXT_PUBLIC_ --
# it must never reach the client bundle. The Next.js BFF proxy (src/app/api/auth/*)
# is the only code that reads this.
EYELEARN_API_URL=http://localhost:8000

# In Vercel, set this in Project Settings -> Environment Variables per
# environment (Preview / Production) to the deployed Django backend's URL.

# Server-only: shared secret Django requires on every request except its
# Stripe webhook (eyelearn/eyelearn/middleware.py). Must match the backend's
# INTERNAL_API_KEY exactly. Never prefix with NEXT_PUBLIC_.
EYELEARN_INTERNAL_API_KEY=

# Server-only Google OAuth Client (Web application type, from Google Cloud
# Console). GOOGLE_OAUTH_CLIENT_ID must match the Django backend's
# GOOGLE_OAUTH_CLIENT_ID. None of these are ever sent to the browser --
# the whole flow (redirect, code exchange, callback) runs server-side in
# src/app/api/auth/google/*.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
